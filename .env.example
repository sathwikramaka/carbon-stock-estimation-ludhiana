# Copy to .env in the project root and fill in your own values.
# Never commit the real .env file.

PROJECT_ROOT=<absolute path to this folder>

# local | cloud
DB_MODE=local

# MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=carbon_stock_ludhiana

# PostgreSQL + PostGIS
PG_HOST=localhost
PG_PORT=5432
PG_DB=postgres
PG_USER=postgres
PG_PASSWORD=<your password>
