# Copy to .env (never commit .env).

# files = serve results/ directly (no database needed); local = PostgreSQL + MongoDB here; cloud = Supabase + Atlas
DB_MODE=files
FRONTEND_ORIGINS=http://localhost:5000
FLASK_DEBUG=0

# Optional: where the pipeline results live (default: <project>/IIRS/Carbon_Stocks/results)
# RESULTS_DIR=

# Local databases (DB_MODE=local, notebook 03)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=carbon_stock_ludhiana
PG_HOST=localhost
PG_PORT=5432
PG_DB=postgres
PG_USER=postgres
PG_PASSWORD=<your password>

# Cloud (DB_MODE=cloud, optional)
# ATLAS_URI=
# SUPABASE_HOST=
# SUPABASE_PORT=6543
# SUPABASE_DB=postgres
# SUPABASE_USER=
# SUPABASE_PASSWORD=
